#!/bin/sh
echo "Running lint checks before push..."

(cd backend && npm run lint) &
BACKEND_PID=$!

(cd frontend && npm run lint) &
FRONTEND_PID=$!

wait $BACKEND_PID
BACKEND_EXIT=$?

wait $FRONTEND_PID
FRONTEND_EXIT=$?

if [ $BACKEND_EXIT -ne 0 ] || [ $FRONTEND_EXIT -ne 0 ]; then
  echo "Lint failed. Fix errors before pushing."
  exit 1
fi

echo "All lint checks passed!"
